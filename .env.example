# BIMcred — example environment file
#
# Copy this file to `.env` and fill in the values:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# `.env` is gitignored. Never commit a real secret, and never put one in this file.
# Generate a session secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# The schema targets PostgreSQL everywhere: local development, the Vercel build
# and the Neon demo database. Create a free Neon project and copy both
# connection strings from the dashboard (Connect > Connection string).
#
#   DATABASE_URL  pooled connection (host contains "-pooler") used by the app.
#                 Append the parameters shown below for serverless clients.
#   DIRECT_URL    direct connection (no "-pooler") used by `prisma db push`
#                 and `npm run db:seed`, which need a real session.
#
# A free Neon project gives you 10 branches, so you can also keep local work in
# its own branch and never touch the demo data.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local Postgres alternative (Docker Compose, or a local install). The provider
# is already "postgresql", so only the URL changes:
# DATABASE_URL="postgresql://bimcred:bimcred_local_only@localhost:5432/bimcred?schema=public"
# DIRECT_URL="postgresql://bimcred:bimcred_local_only@localhost:5432/bimcred?schema=public"

# HMAC key for the `bimcred_session` cookie. Minimum 32 random bytes, base64 encoded.
# In production the app refuses to sign sessions without it, so a deploy with a
# missing secret fails closed instead of accepting forged cookies.
SESSION_SECRET="replace-with-a-32-byte-random-value"

# Reserved. Documentation only: no module reads this, and there is no CSRF origin
# check or email link builder yet.
APP_URL="http://localhost:3000"

# `development` locally, `production` when serving a real build. `production` adds
# the `Secure` attribute to the session cookie and enables the secret check above.
# Vercel sets NODE_ENV=production for you; do not override it there.
NODE_ENV="development"

# Renders the phone OTP code in the candidate UI so the demo needs no SMS provider.
# This flag is read directly and is NOT gated by NODE_ENV. Take the free demo
# online with it set to "true" so new candidates can verify a phone; set it to
# "false" as soon as a real SMS provider is connected. Leaving it on means anyone
# can read the code for a number they control.
DEV_SHOW_OTP="true"

# Reserved for a structured logger. The app uses console output and this value is
# not read.
LOG_LEVEL="debug"

# ---------------------------------------------------------------------------
# SMS (phone verification) — reserved, not read by the app
# The demo generates the code in `sendOtpAction`; there is no transport or adapter.
# ---------------------------------------------------------------------------

SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID="BIMcred"
# Shared secret for a delivery-status webhook, once a real provider is connected.
SMS_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Email (transactional only) — reserved, not read by the app
# No email is sent in the prototype.
# ---------------------------------------------------------------------------

EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@bimcred.test"

# ---------------------------------------------------------------------------
# Payments — reserved, not read by the app
# Billing is simulated; there is no Stripe integration or webhook endpoint.
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Object storage — reserved, not read by the app
# There are no file uploads; candidate portfolios are external links.
# ---------------------------------------------------------------------------

BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Feature flags — reserved, not read by the app
# These document intended seams. They are not working kill switches; changing one
# has no effect on the running application.
# ---------------------------------------------------------------------------

FEATURE_SMS_LIVE="false"
FEATURE_BILLING="false"
FEATURE_OBJECT_STORAGE="false"

# ---------------------------------------------------------------------------
# Docker Compose only (read by docker-compose.yml, not by the Next.js app).
# Local values. Do not reuse in production.
# ---------------------------------------------------------------------------

POSTGRES_USER="bimcred"
POSTGRES_PASSWORD="bimcred_local_only"
POSTGRES_DB="bimcred"
POSTGRES_PORT="5432"
APP_PORT="3000"
